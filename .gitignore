# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Environment / secrets
.env

# IDE
.idea/
.vscode/
.settings/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Data
# data/raw/_incoming/ holds the small, seeded source-system extracts --
# tracked so the repo is runnable/inspectable without regenerating them.
# Everything else under data/ is pipeline output (ingested batches, run
# manifests, curated, rejected) and is intentionally not tracked.
data/raw/*
!data/raw/.gitkeep
!data/raw/_incoming/
!data/raw/_incoming/**

data/curated/*
!data/curated/.gitkeep

data/rejected/*
!data/rejected/.gitkeep

data/validated/*
!data/validated/.gitkeep

data/warehouse/*
!data/warehouse/.gitkeep

# V2 (Airflow + PySpark) -- local-only artifacts
data/spark_staging/
orchestration/.env.airflow
orchestration/logs/
# Spark local-metastore droppings (created if a job ever touches Hive/derby)
spark-warehouse/
metastore_db/
derby.log
*.crc

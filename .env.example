# Copy this file to .env and fill in real values for your local setup.
# .env is gitignored -- never commit real credentials.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dataeng_warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- NL2SQL: LLM provider (src/nl2sql/generation.py + providers/) ---
#
# Which provider answers natural-language questions. One of:
#   anthropic  -- Claude (default if left unset, for backward compatibility)
#   gemini     -- Google Gemini -- preferred if you want a free-tier cloud option
#   ollama     -- a locally running Ollama model -- no cloud API key, no cost
#   openrouter -- OpenAI-compatible access to many models, including free ones
#
# Only the selected provider's settings below are required -- e.g. with
# NL2SQL_PROVIDER=gemini, ANTHROPIC_API_KEY/OPENROUTER_API_KEY are never
# read and don't need to be set.
NL2SQL_PROVIDER=anthropic

# Anthropic Claude -- get a key at https://console.anthropic.com/
# (ANTHROPIC_AUTH_TOKEN also works in place of ANTHROPIC_API_KEY, if you
# use that form of Anthropic credential instead.)
ANTHROPIC_API_KEY=

# Google Gemini -- get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter -- get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama -- run `ollama serve` locally first; no key needed. Only used
# when NL2SQL_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Model name/slug for whichever provider is selected above:
#   anthropic  -- optional, defaults to claude-opus-5
#   gemini     -- optional, defaults to Google's rolling "gemini-flash-latest"
#                 alias; set a pinned version here instead if you prefer
#                 (see https://ai.google.dev/gemini-api/docs/models)
#   ollama     -- required -- must match a model you've already pulled
#                 locally (`ollama pull <model>`), e.g. llama3.1
#   openrouter -- required -- a model slug from https://openrouter.ai/models,
#                 e.g. meta-llama/llama-3.1-8b-instruct:free
NL2SQL_MODEL=

# Copy to airflow/.env.airflow and fill in the warehouse password.
# airflow/.env.airflow is gitignored.
#
# These variables are read by the DAG's load_postgres / quality_check
# tasks (via config/settings.py) to reach the EXISTING PostgreSQL
# warehouse. That warehouse runs on your host, NOT in a container --
# host.docker.internal is how the Airflow containers reach the host.
#
# The Airflow metadata database is a separate container (postgres:16-alpine,
# not exposed to the host) and needs nothing configured here.

POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=dataeng_warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
